# Copy to .env and fill in (docs/11 §4). NEVER commit .env. Testnet keys only.
# ---------- Network ----------
CHAIN_ID=43113
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
FUJI_RPC_URL_FALLBACK=
AVALANCHE_MAINNET_RPC_URL=https://api.avax.network/ext/bc/C/rpc   # fork tests only
SNOWTRACE_VERIFIER_URL=https://api.routescan.io/v2/network/testnet/evm/43113/etherscan
SNOWTRACE_API_KEY=verifyContract

# ---------- Keys (TESTNET ONLY, never commit) ----------
DEPLOYER_PRIVATE_KEY=0x<deployer_and_admin_testnet_key>
AGENT_PRIVATE_KEY=0x<agent_testnet_key>
KEEPER_PRIVATE_KEY=0x<keeper_testnet_key>

# ---------- Deployment parameters ----------
ADMIN_ADDRESS=0x<admin_address>
AGENT_ADDRESS=0x<agent_address>
DEMO_MODE=true
SAFETY_HORIZON_SEC=1209600          # 14 days
EMERGENCY_BUFFER=10000000000        # 10,000 USDC (6 decimals)
MAX_EXPOSURE_BPS=7000
POOL_INITIAL_APY_BPS=800
POOL_INITIAL_UTILIZATION_BPS=5000
TREASURY_SEED_AMOUNT=100000000000   # 100,000 mUSDC
POOL_INTEREST_RESERVE=10000000000   # 10,000 mUSDC
CIRCLE_USDC_FUJI=0x5425890298aed601595a70AB815c96711a31Bc65
RECIPIENT_PAYROLL=0x<recipient1>
RECIPIENT_PAYROLL_2=0x<recipient2>
RECIPIENT_GRANT=0x<recipient3>

# ---------- Backend ----------
PORT=4000
DATABASE_URL=file:./runwaymind.db
SESSION_SECRET=<random_64_hex>
APP_ORIGIN=http://localhost:3000
DEPLOYMENT_FILE=../deployment/fuji.json
AGENT_LOOP_INTERVAL_SEC=30
KEEPER_INTERVAL_SEC=15
AGENT_ENABLED=true
KEEPER_ENABLED=true
INDEXER_BLOCK_RANGE=2048            # max eth_getLogs range; free-tier RPCs need less (Alchemy 10, QuickNode 5)
INDEXER_MAX_CHUNKS_PER_POLL=20

# ---------- LLM ----------
LLM_ENABLED=true
LLM_PROVIDER=anthropic              # anthropic | openai
LLM_MODEL=<model_id>
LLM_API_KEY=<llm_api_key>
LLM_TIMEOUT_MS=8000
LLM_BASE_URL=                       # optional API-compatible relay (https); empty = official provider API

# ---------- Frontend (public) ----------
NEXT_PUBLIC_CHAIN_ID=43113
NEXT_PUBLIC_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=<reown_project_id>
NEXT_PUBLIC_SNOWTRACE_BASE=https://testnet.snowtrace.io
