{
  "name": "@runwaymind/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify REST API, scheduler for agent and keeper",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test prisma",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@runwaymind/agent": "workspace:*",
    "@runwaymind/shared": "workspace:*",
    "fastify": "^4.29.0",
    "fastify-type-provider-zod": "^2.1.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.2.0",
    "@prisma/client": "^5.22.0",
    "jose": "^5.9.6",
    "viem": "^2.21.55",
    "zod": "^3.24.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
